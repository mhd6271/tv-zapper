<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.mhd6271.tvzapper"
    android:versionCode="22"
    android:versionName="0.4.13">

    <!-- KOMPAT: minSdk 26 ist zugesagt, der Code ruft aber Methoden ab API 29 (startForeground mit Typ,
         unsafeCheckOpNoThrow) und API 33 (InputStream.readAllBytes) direkt auf – Android 8 bis 12 stuerzen ab. Geprueft nur Android 14 (TCL). -->
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Senderliste und laufende Sendungen aus der Android-TV-Datenbank (TvContract) -->
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <!-- KOMPAT: READ_TV_LISTINGS stellt der TvProvider (am TCL "dangerous", zur Laufzeit erteilt); nicht im oeffentlichen SDK.
         Ob andere Hersteller/aeltere Android-Versionen fremde Sender und Sendungen an Dritt-Apps herausgeben, ist ungeprueft. -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <!-- Werbeerkennung: Senderliste und Stream von der FRITZ!Box im Heimnetz -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- eigene IP-Adresse fuer die Anzeige "Schnittstelle fuer Home Assistant" -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Dauerlauf im Hintergrund -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Umschalten aus dem Hintergrund (Android erlaubt Activity-Starts sonst nicht) -->
    <!-- KOMPAT: Manche Android-TV-Firmwares haben keine Seite "Ueber anderen Apps" – dann nur per adb
         (appops set io.github.mhd6271.tvzapper SYSTEM_ALERT_WINDOW allow). Ohne sie kein Umschalten aus dem Hintergrund, keine Einblendung. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Pruefen, ob gerade das Fernsehprogramm vorn ist -->
    <!-- KOMPAT: Auch die Seite "Nutzungszugriff" fehlt auf manchen TV-Firmwares (dann adb: appops set ... GET_USAGE_STATS allow);
         ohne sie weiss die App nicht, ob das Fernsehbild vorn ist, und schaltet nie. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

    <!-- Welche App spielt einen Sender ab? (am TCL com.tcl.tv) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android.cursor.item/channel" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:theme="@android:style/Theme.DeviceDefault"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".EinblendungEmpfaenger"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.mhd6271.tvzapper.EINBLENDEN" />
            </intent-filter>
        </receiver>

        <!-- Abfragen und Umschalten von aussen (Home Assistant per adb), nur mit DUMP-Recht -->
        <receiver
            android:name=".AbfrageEmpfaenger"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.mhd6271.tvzapper.ABFRAGEN" />
                <action android:name="io.github.mhd6271.tvzapper.UMSCHALTEN" />
                <action android:name="io.github.mhd6271.tvzapper.PAUSEN_LOESCHEN" />
                <action android:name="io.github.mhd6271.tvzapper.EINSTELLEN" />
                <action android:name="io.github.mhd6271.tvzapper.STARTEN" />
            </intent-filter>
        </receiver>

        <!-- KOMPAT: specialUse gibt es erst ab Android 14; wie aeltere Versionen den unbekannten Typ behandeln, ist ungeprueft.
             Fuer Google Play muesste specialUse begruendet werden. -->
        <service
            android:name=".ZapperService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Prueft regelmaessig das laufende Fernsehprogramm und schaltet um" />
        </service>
    </application>
</manifest>
